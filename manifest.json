{
  "schemaVersion": 10,
  "id": "higgsfield",
  "name": "Higgsfield",
  "description": "AI video clips and images the agent can cut into your edits.",
  "capabilities": {
    "video-generation": {
      "name": "Video generation",
      "description": "Generate clips with 41 models: text, frames, references, motion transfer, extending and editing clips."
    },
    "image-generation": {
      "name": "Image generation",
      "description": "Generate images with 14 models, from photo-real people to typography and ads, following reference images where the model takes them."
    }
  },
  "settings": [
    {
      "id": "api-key",
      "label": "Higgsfield API key",
      "description": "Paste it as KEY_ID:KEY_SECRET from the Higgsfield console. Used for generated clips. Stored in the system vault; agents can use it through Arrumo but never read it.",
      "kind": "secret",
      "scope": "workspace",
      "required": true,
      "helpUrl": "https://console.higgsfield.ai/"
    },
    {
      "id": "video-model",
      "label": "Video model",
      "description": "The model used when you or the agent don't pick one. Generate shows what each is best for.",
      "kind": "string",
      "scope": "workspace",
      "required": false,
      "choices": [
        "cinema-studio-4.0",
        "genjutsu-motion-transfer",
        "genjutsu-object-swap",
        "grok-imagine-video-1.5",
        "happy-horse-1.0",
        "happy-horse-1.0-reference",
        "happy-horse-1.1",
        "happy-horse-1.1-reference",
        "kling-2.5-turbo-pro",
        "kling-2.5-turbo-std",
        "kling-2.6-motion-pro",
        "kling-2.6-motion-std",
        "kling-2.6-pro",
        "kling-3.0-4k",
        "kling-3.0-motion-pro",
        "kling-3.0-motion-std",
        "kling-3.0-pro",
        "kling-3.0-std",
        "kling-3.0-turbo",
        "kling-o3",
        "kling-o3-edit",
        "kling-o3-reference",
        "kling-omni",
        "kling-omni-edit",
        "kling-omni-reference",
        "ltx-2.5-fast",
        "ltx-2.5-pro",
        "minimax-h3",
        "minimax-h3-reference",
        "seedance-2.0",
        "seedance-2.0-reference",
        "seedance-2.5",
        "seedance-2.5-edit",
        "seedance-2.5-extend",
        "seedance-2.5-reference",
        "wan-2.6",
        "wan-2.7-reference",
        "wan-3.0",
        "wan-3.0-prime",
        "wan-3.0-prime-reference",
        "wan-3.0-reference"
      ],
      "default": "kling-3.0-std"
    },
    {
      "id": "image-model",
      "label": "Image model",
      "description": "The model used when you or the agent don't pick one. Generate shows what each is best for.",
      "kind": "string",
      "scope": "workspace",
      "required": false,
      "choices": [
        "grok-image-2",
        "ideogram-4",
        "marketing-studio",
        "marketing-studio-flare",
        "marketing-studio-sunburst",
        "qwen-image-3",
        "recraft-4.1",
        "recraft-4.1-pro",
        "recraft-4.1-utility",
        "recraft-4.1-utility-pro",
        "soul",
        "soul-2",
        "soul-cinema",
        "z-image-turbo"
      ],
      "default": "qwen-image-3"
    }
  ],
  "introduction": {
    "headline": {
      "en": "Short clips, made to order",
      "es": "Clips cortos, hechos a medida",
      "pt": "Clipes curtos, feitos à medida"
    },
    "body": {
      "en": "Higgsfield makes short AI video clips and images from a prompt, and can follow reference images and clips from your assets. The agent can ask for one when a scene needs b-roll, and it lands in Assets like everything else.",
      "es": "Higgsfield crea clips de vídeo cortos e imágenes con IA a partir de una descripción, y puede seguir imágenes y clips de referencia de tus recursos. El agente puede pedir uno cuando una escena necesita recursos, y aparece en Recursos como todo lo demás.",
      "pt": "O Higgsfield cria clipes de vídeo curtos e imagens com IA a partir de uma descrição, e pode seguir imagens e clipes de referência dos teus recursos. O agente pode pedir um quando uma cena precisa de imagens de apoio, e aparece em Recursos como tudo o resto."
    }
  },
  "icon": "icon.svg",
  "iconNotice": "Higgsfield and its logo are trademarks of Higgsfield AI.",
